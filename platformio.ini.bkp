; PlatformIO Project Configuration File
; ESP32-S3 LVGL + Web Framework Integration
;
; Combines:
; - LVGL Display System (JC4827W543)
; - ESP32 Web Framework
; - WiFi/WebSocket Real-time Communication

[env:esp32-s3-devkitc1-n4r8]
platform = espressif32
board = esp32-s3-devkitc1-n4r8
board_build.f_cpu = 240000000L
framework = arduino
board_build.partitions = custom_partitions.csv
board_build.filesystem = spiffs

build_unflags = 
	-std=gnu++11 

build_flags = 
	-std=gnu++17
	-DBOARD_HAS_PSRAM
	-DARDUINO_USB_CDC_ON_BOOT=1
	-DARDUINO_USB_MODE=2
	-DCONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=1
    -DCONFIG_ESP_DEBUG_OCDAWARE=1
	;new konfigs
	
	; LVGL Configuration
	-DLV_CONF_INCLUDE_SIMPLE
	-DLV_CONF_PATH="${PROJECT_DIR}/include/lv_conf.h"
	
	; Performance
	-O2
	-DCORE_DEBUG_LEVEL=3
	
	; Compiler warnings
	-Wno-narrowing
	-Wno-macro-redefined
	-Wno-deprecated-declarations
	
	; ESP32 Configuration
	-DCONFIG_IDF_TARGET_ESP32S3=1
	-D__extension__=__extension__
	-Dtypeof=__typeof__
	
	; Graphics
	-DARDUINO_GFX_LIBRARY_MINIMAL

lib_deps = 
	moononournation/GFX Library for Arduino@^1.4.7
	lvgl/lvgl@^8.3.11
	bblanchon/ArduinoJson@^7.0.0
	gilmaimon/ArduinoWebsockets@^0.5.3

lib_extra_dirs = 
	${PROJECT_DIR}/lib

; Upload via USB
upload_speed = 115200
upload_port = COM7
upload_flags = 
	--before=default_reset
	--after=hard_reset
	--chip=esp32s3

; Serial Monitor Configuration
monitor_port = COM8
monitor_speed = 115200
monitor_dtr = 0
monitor_rts = 0
monitor_filters = esp32_exception_decoder

; Debug configuration
debug_tool = esp-builtin
debug_init_break = tbreak setup
